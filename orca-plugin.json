{
  "manifestVersion": 2,
  "id": "project-progress",
  "name": "Project Progress",
  "version": "0.1.0",
  "description": "Checklist e progresso do plano Markdown do workspace em foco.",
  "license": "MIT",
  "repository": "https://github.com/Tonimusic9/orca-todos",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "progress",
        "title": "Project Progress",
        "icon": "bar-chart-3",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "events": [
      {
        "on": "workspace.changed"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "storage:own"
    }
  ]
}
